# fd-scraw-harness .env.example

# Linjie AI (GM51/QModel/KModel) - Recommended
# Copy this file to .env (git-ignored) and paste your real key there.
LINJIE_API_KEY=sk-your-linjie-api-key
LINJIE_BASE_URL=https://www.linjie.love/v1

# LLM model for each phase
HARNESS_LITELLM_MODEL=linjie/gm51model           # General purpose model
HARNESS_MODEL_DISCOVERY=linjie/gm51model         # Discovery uses: gm51model or qmodel_latest
HARNESS_MODEL_GENERATION=linjie/qmodel_latest    # Generation uses more capable model

# Database (default: SQLite at data/harness.db)
# HARNESS_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/db

# Alternative providers (commented out)
# DEEPSEEK_API_KEY=sk-...
# ARK_API_KEY=...        # for Doubao via Volcengine Ark

# ── Async tool timeouts (seconds) ─────────────────────────────────────
# HARNESS_TOOL_TIMEOUT_ANALYZE_PAGE=60
# HARNESS_TOOL_TIMEOUT_TEST_SPIDER=300
# HARNESS_TOOL_TIMEOUT_DISCOVER_SOURCES=120
# HARNESS_TOOL_TIMEOUT_GENERATE_MANIFEST=180
# HARNESS_TOOL_TIMEOUT_COVERAGE_REPORT=120
# HARNESS_TOOL_TIMEOUT_TEST_ALL_SPIDERS=600

# ── Concurrency limits ────────────────────────────────────────────────
# HARNESS_LLM_CONCURRENCY=5
# HARNESS_SPIDER_CONCURRENCY=3
# HARNESS_ANALYSIS_CONCURRENCY=2
