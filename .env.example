# fd-scraw-harness .env.example

# Database (default: SQLite at data/harness.db)
# HARNESS_DATABASE_URL=postgresql+psycopg2://user:pass@192.168.1.4:5432/finddata

# LiteLLM model configuration
# Default model (used for all phases if phase-specific not set)
# HARNESS_LITELLM_MODEL=deepseek-chat

# Phase-specific models
# HARNESS_MODEL_DISCOVERY=doubao-pro-32k
# HARNESS_MODEL_GENERATION=deepseek-chat

# LiteLLM API keys (set the ones you need)
# DEEPSEEK_API_KEY=sk-...
# ARK_API_KEY=...        # for Doubao via Volcengine Ark
# OPENAI_API_KEY=sk-...
